{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VrushPDF",
  "mainBinaryName": "vrushpdf",
  "version": "../package.json",
  "identifier": "com.nachiket.vrushpdf",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "VrushPDF",
        "width": 1400,
        "height": 900,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "nashv",
    "homepage": "https://github.com/nashv/PDFEditor",
    "copyright": "Copyright © 2026 nashv",
    "license": "LicenseRef-VrushPDF-EULA",
    "category": "Productivity",
    "shortDescription": "Read, annotate and reorganise PDFs.",
    "longDescription": "A desktop PDF viewer and annotation editor. Highlight, underline, draw, add shapes, text boxes, comments, stamps and signatures, and rearrange pages. Annotations are written as standard PDF annotation objects with real appearance streams, so they stay editable in other readers.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF Document",
        "description": "Portable Document Format",
        "role": "Editor",
        "mimeType": "application/pdf"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  }
}
